{
  "name": "ohos-perf-workspace",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": "^22.13.0 || >=23.4.0"
  },
  "scripts": {
    "build": "npm run build -w @ohos-perf/core",
    "test": "npm run build -w @ohos-perf/core && npm run build -w @ohos-perf/cli && npm run test:unit && npm run test:device",
    "test:unit": "vitest run --project unit",
    "test:device": "vitest run --project device --fileParallelism=false",
    "typecheck": "npm run typecheck -w @ohos-perf/core && npm run typecheck -w @ohos-perf/cli",
    "verify": "npm run build && npm run typecheck && npm run test:unit"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "vitest": "^2.1.0",
    "tsup": "^8.3.0",
    "@types/node": "^24.0.0"
  },
  "version": "0.22.3",
  "description": "**HarmonyOS performance, made measurable.**",
  "main": "index.js",
  "directories": {
    "doc": "docs",
    "test": "test"
  },
  "dependencies": {
    "acorn": "^8.19.0",
    "any-promise": "^1.3.0",
