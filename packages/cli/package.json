{
  "name": "@ohos-perf/cli",
  "version": "0.3.0",
  "description": "Command-line interface for HarmonyOS performance analysis: doctor, caps, collect, analyze, query, tools, compare, gesture and emulator",
  "keywords": [
    "harmonyos",
    "openharmony",
    "ohos",
    "performance",
    "profiling",
    "cli",
    "hapray"
  ],
  "type": "module",
  "bin": {
    "ohos-perf": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": "^22.13.0 || >=23.4.0"
  },
  "license": "MIT",
  "author": "growvv",
  "homepage": "https://growvv.github.io/ohos-perf/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/growvv/ohos-perf.git",
    "directory": "packages/cli"
  },
  "bugs": {
    "url": "https://github.com/growvv/ohos-perf/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@ohos-perf/core": "0.3.0",
    "commander": "^12.1.0"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --target node22",
    "typecheck": "tsc --noEmit -p tsconfig.test.json",
    "pretest": "npm run build -w @ohos-perf/core",
    "test": "vitest run",
    "prepublishOnly": "npm run build"
  }
}
